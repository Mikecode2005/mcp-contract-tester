{
  "name": "mcp-contract-tester",
  "version": "0.1.0",
  "description": "A dependency-free CLI for validating, recording, and replaying MCP tool contracts.",
  "type": "module",
  "bin": { "mcp-contract-tester": "./bin/mcp-contract-tester.js" },
  "scripts": { "test": "node --test", "check": "node --check bin/mcp-contract-tester.js && node --check src/*.js", "build": "node ./scripts/build.mjs", "dev": "wrangler dev", "deploy": "wrangler deploy" },
  "files": ["bin", "src", "test", "examples", "public", "README.md", "CONTRIBUTING.md", "SECURITY.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "devDependencies": { "wrangler": "^4.97.0" },
  "license": "MIT"
}